# KORVEX Anti-Chatter
# Da acceso a /dev/uinput y a los teclados al usuario de la sesión local activa
# (etiqueta "uaccess" de systemd-logind), para que el programa funcione sin root.
# Debe ordenarse antes de 73-seat-late.rules.
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"
